# Postgres connection used by the Next.js server for all reads/writes.
#  - Local (npm run db:local):  postgres://postgres:postgres@localhost:54329/postgres
#  - Supabase: Project Settings -> Database -> Connection string (use the "Session pooler" URI)
DATABASE_URL=postgres://postgres:postgres@localhost:54329/postgres

# Optional: enables Supabase Realtime push in the browser (Project Settings -> API).
# Leave empty to fall back to polling every 2 s (e.g. with the local database).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
