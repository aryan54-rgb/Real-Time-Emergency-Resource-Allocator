{
  "name": "pulseroute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "node scripts/db-local.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-cli.mjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-cli.mjs seed",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db-cli.mjs reset",
    "test:race": "node scripts/race-test.mjs",
    "test:e2e": "node scripts/e2e-test.mjs",
    "test:realtime": "node --env-file-if-exists=.env.local scripts/realtime-check.mjs",
    "verify": "node scripts/verify.mjs",
    "simulate": "node --env-file-if-exists=.env.local scripts/simulate.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "leaflet": "^1.9.4",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "5.9",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  }
}
